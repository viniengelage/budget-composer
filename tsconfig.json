{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./modules/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts",
    "scripts/**/*.ts",
    "App.tsx",
    "index.ts"
  ],
  "exclude": ["node_modules", "ios", "android", "macos", "windows", "dist"]
}
