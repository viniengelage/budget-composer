{
  "name": "orcamentos-grameira",
  "version": "1.0.0",
  "private": true,
  "description": "Gerador de orcamentos para a Grameira do Jonas",
  "scripts": {
    "dev": "hutch run dev",
    "dev:hmr": "hutch run dev:hmr",
    "devkit": "hutch electrobun prepare",
    "ui": "vite build",
    "preview:doc": "vite build && bun run scripts/preview-document.tsx",
    "build": "bun run scripts/build.ts",
    "build:canary": "bun run scripts/build.ts --env canary",
    "build:windows": "bun run scripts/build.ts --target windows",
    "build:macos": "bun run scripts/build.ts --target macos",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.ts\"",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run devkit && bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bun": "^1.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.9"
  }
}
