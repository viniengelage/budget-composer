{
  "name": "orcamentos-grameira",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "macos": "react-native run-macos",
    "windows": "react-native run-windows",
    "prebuild": "bun node_modules/expo-desktop/build/cli.js prebuild --platform desktop --template expo-desktop-template-bare-minimum@beta",
    "build": "bun run scripts/build.ts",
    "build:macos": "bun run scripts/build.ts --platform macos",
    "build:windows": "bun run scripts/build.ts --platform windows",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run typecheck && bun run lint && bun run test",
    "autolink-windows": "react-native autolink-windows"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.90.2",
    "date-fns": "^4.1.0",
    "expo": "~54.0.35",
    "expo-desktop-modules-core": "~54.0.14-beta.0",
    "expo-desktop-prebuild-config": "~1.1.0-beta.0",
    "expo-desktop-stubs": "~54.0.14-beta.0",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.4",
    "react-hook-form": "^7.64.0",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.7",
    "react-native-svg": "^15.15.5",
    "react-native-windows": "0.81.35",
    "rnw-sqlite": "file:./modules/rnw-sqlite",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@expo/config-plugins": "56.0.16",
    "@react-native-community/cli": "^20.1.3",
    "@types/bun": "^1.3.2",
    "@types/react": "~19.2.17",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo-desktop": "^1.0.0-beta.5",
    "expo-desktop-metro-config": "~54.81.0-beta.2",
    "expo-desktop-template-bare-minimum": "~54.81.1-beta.5",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.2"
  },
  "overrides": {
    "react": "19.1.4",
    "react-native": "0.81.6"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-native"
      ]
    }
  }
}
