# Semente de desenvolvimento da empresa — copie para `.env.local` e preencha.
#
# `.env.local` está no .gitignore: dado pessoal (CPF, telefone, e-mail) fica na
# sua máquina e não entra no repositório. Só é lido quando __DEV__ é true.
#
# Assim que a tela de Configurações estiver pronta, isto vira desnecessário —
# o que a usuária salvar sempre vence esta semente.

EXPO_PUBLIC_DEV_COMPANY={"name":"Minha Empresa","document":"00.000.000/0001-00","phone":"(00) 00000-0000","email":"contato@exemplo.com","address":"Rua Exemplo, nº 100","district":"Centro","city":"Foz do Iguaçu","state":"PR","zipCode":"85850-000","pixKey":"(00) 00000-0000","pixHolder":"Nome do Titular"}
